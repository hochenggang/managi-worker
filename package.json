{
  "name": "managi-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "把 managi-v3 的 Web SSH 工作台搬到 Cloudflare Workers：浏览器直连 SSH，Worker 只做中转，凭据不落盘。",
  "cloudflare": {
    "label": "Managi WebSSH",
    "products": [
      "Workers",
      "Durable Objects",
      "KV"
    ],
    "categories": [
      "starter"
    ],
    "bindings": {
      "MANAGI_AUTH": {
        "description": "访问口令，格式 `用户名:密码`（例如 `ops:my-long-password`）。**默认 admin:admin，部署后请尽快改成自己的**；确需公开访问请显式设为 `off`。"
      },
      "MANAGI_KNOWN_HOSTS": {
        "description": "记录首次连接时信任的 SSH 主机密钥（TOFU），部署时自动创建。",
        "type": "kv_namespace"
      }
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:web": "node scripts/build-web.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "check": "npm run typecheck && npm run test && wrangler deploy --dry-run --outdir .wrangler/build"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": ">=20"
  }
}
